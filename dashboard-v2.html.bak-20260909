<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Signal Book — 테마 주식 리서치</title>
<meta name="description" content="AI, 로봇, 원전 및 에너지, 바이오 테마의 국내외 주식을 탐색하는 리서치 대시보드">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css">
<style>
:root{--bg:#f3f5f3;--card:#fff;--ink:#142019;--muted:#68756d;--line:#dbe2dd;--soft:#eef2ef;--green:#08784a;--greenbg:#edf8f2;--red:#bf3e34;--redbg:#fff1ef;--amber:#87620e;--amberbg:#fff7e2;--nav:#101a14;--lime:#c1f441}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,"Noto Sans KR",sans-serif;font-size:16px;font-variant-numeric:tabular-nums}button,input,select{font:inherit}button{cursor:pointer}a{color:inherit}
.top{position:sticky;top:0;z-index:20;background:var(--nav);color:#fff}.topline{height:64px;max-width:1580px;margin:auto;padding:0 26px;display:flex;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:10px;font-weight:800}.mark{width:31px;height:31px;border-radius:8px;background:var(--lime);color:#132016;display:grid;place-items:center;font:700 18px Georgia}.brand small{font-size:12px;color:#99a59d;letter-spacing:.08em}.context{margin-left:auto;text-align:right}.context b{display:block;font-size:14px}.context small{display:block;color:#9ea9a2;font-size:12px;margin-top:2px}
.themes{background:#fff;border-bottom:1px solid var(--line)}.themein{max-width:1580px;margin:auto;padding:11px 26px;display:flex;gap:7px;align-items:center;overflow:auto}.themein>span{font-size:13px;color:var(--muted);font-weight:800;margin-right:5px;white-space:nowrap}
.theme,.market,.period{border:1px solid var(--line);background:#fff;color:#526058;border-radius:7px;padding:8px 13px;font-size:14px;font-weight:800;white-space:nowrap}.theme.active,.market.active,.period.active{background:var(--nav);border-color:var(--nav);color:#fff}
.layout{max-width:1580px;margin:auto;padding:16px 26px 36px;display:grid;grid-template-columns:320px minmax(0,1fr);gap:14px}.sidebar,.detail{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}.sidebar{position:sticky;top:137px;align-self:start}.sidehead{padding:16px;border-bottom:1px solid var(--line)}.path{font-size:13px;color:var(--muted);margin-bottom:11px}.path b{color:var(--ink)}.markets{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px}.market{padding:9px}.tools{display:grid;grid-template-columns:minmax(0,1fr) 112px;gap:6px}.search,.sort{min-width:0;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink);padding:9px 10px;font-size:14px}.summary{display:flex;justify-content:space-between;gap:8px;margin-top:11px;color:var(--muted);font-size:12px}.stocklist{height:calc(100vh - 285px);min-height:300px;overflow:auto;padding:7px}.stock{width:100%;border:1px solid transparent;background:#fff;border-radius:8px;padding:11px 10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;text-align:left}.stock:hover{background:#f7f9f7}.stock.active{background:#f0f4f1;border-color:#c9d5cd;box-shadow:inset 3px 0 var(--green)}.sname{min-width:0}.sname b{display:block;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sname span{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:12px;margin-top:4px}.squote{text-align:right}.squote b{display:block;font-size:14px}.squote small{display:block;font-size:13px;font-weight:800;margin-top:4px}.dot{width:7px;height:7px;border-radius:50%;background:#ba8c25}.dot.real{background:var(--green)}.up{color:var(--green)!important}.down{color:var(--red)!important}.neutral{color:var(--muted)!important}.empty{padding:38px 20px;text-align:center;color:var(--muted);font-size:14px;line-height:1.65}
.dhead{padding:22px 24px 18px;border-bottom:1px solid var(--line)}.crumb{font-size:13px;color:var(--muted);margin-bottom:12px}.company{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.title h1{font:700 28px/1.2 Georgia,"Noto Sans KR",serif;margin:0}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.tag{font-size:12px;color:#59675e;border:1px solid var(--line);border-radius:999px;padding:4px 8px}.mainquote{text-align:right;white-space:nowrap}.mainquote strong{font-size:28px;letter-spacing:-.03em}.mainquote>span{display:block;font-size:15px;font-weight:800;margin-top:4px}.mainquote small{display:block;font-size:12px;color:var(--muted);margin-top:5px}.databadge{display:inline-flex!important;width:max-content;margin-left:auto;padding:4px 7px;border-radius:999px;background:var(--soft);font-size:12px!important;color:#5d6a62!important}.databadge.warn{background:var(--amberbg);color:var(--amber)!important}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.kpi{padding:18px 20px;border-right:1px solid var(--line);min-height:142px}.kpi:last-child{border-right:0}.klabel{font-size:13px;color:var(--muted);font-weight:800}.kvalue{font-size:23px;font-weight:800;margin-top:11px;letter-spacing:-.02em}.ksub{font-size:13px;color:#526058;line-height:1.55;margin-top:8px}.chip{display:inline-block;padding:4px 7px;border-radius:999px;font-size:12px;font-weight:800;margin-left:4px;vertical-align:middle}.chip.green{background:var(--greenbg);color:var(--green)}.chip.red{background:var(--redbg);color:var(--red)}.chip.amber{background:var(--amberbg);color:var(--amber)}.chip.gray{background:var(--soft);color:var(--muted)}.track{height:5px;border-radius:99px;background:#e6ebe7;margin-top:11px;overflow:hidden}.fill{height:100%;background:var(--green);border-radius:99px}
.section{padding:22px 24px;border-bottom:1px solid var(--line)}.section:last-child{border-bottom:0}.shead{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:13px}.shead h2{font-size:16px;margin:0}.shead p{font-size:12px;color:var(--muted);margin:4px 0 0}.periods{display:flex;gap:4px;overflow:auto}.period{padding:6px 9px;font-size:12px}.chart{height:510px;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:#fafbfa}.tradingview-widget-container{height:100%;width:100%}.tradingview-widget-container__widget{height:calc(100% - 28px);width:100%}.tradingview-widget-copyright{height:28px;padding:7px 10px;font-size:12px;color:var(--muted)}.fallback{height:100%;display:grid;place-items:center;text-align:center;padding:24px}.fallback h3{font-size:19px;margin:0 0 8px}.fallback p{max-width:560px;margin:0 auto 17px;color:var(--muted);font-size:14px;line-height:1.65}.tvlink{display:inline-block;padding:10px 14px;border-radius:7px;background:var(--nav);color:#fff;text-decoration:none;font-size:14px;font-weight:800}
.thesis{border-left:3px solid var(--green);background:#f7f9f7;padding:12px 14px;font-size:15px;line-height:1.7;margin-bottom:14px}.swot{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:9px;overflow:hidden}.swotcell{padding:16px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.swotcell:nth-child(2n){border-right:0}.swotcell:nth-child(n+3){border-bottom:0}.swotcell h3{font-size:14px;margin:0 0 9px}.swotcell ul{margin:0;padding-left:18px}.swotcell li{font-size:14px;line-height:1.55;margin:5px 0;color:#435148}.kind{font-size:11px;color:var(--muted);font-weight:800;margin-right:5px}details{margin-top:10px}summary{cursor:pointer;font-size:12px;color:var(--muted);font-weight:800}.source{font-size:12px;color:var(--muted);line-height:1.55;margin-top:8px}.source a{color:var(--green);font-weight:800}
.catalysts{display:grid;grid-template-columns:1fr 1fr;gap:10px}.catcol{border:1px solid var(--line);border-radius:9px;overflow:hidden}.cattitle{padding:11px 14px;font-size:14px;font-weight:800;border-bottom:1px solid var(--line)}.cattitle.pos{background:var(--greenbg);color:var(--green)}.cattitle.neg{background:var(--redbg);color:var(--red)}.catbody{padding:15px}.catbody h3{font-size:15px;margin:0 0 7px}.catbody p{font-size:14px;line-height:1.55;color:#526058;margin:6px 0}.catmeta{display:grid;grid-template-columns:78px 1fr;gap:5px;font-size:12px;color:var(--muted);margin-top:11px}.catmeta b{color:#435047}.foot{padding:16px 24px;background:#f8faf8;color:var(--muted);font-size:12px;line-height:1.6}
@media(max-width:900px){.layout{grid-template-columns:1fr;padding:12px}.sidebar{position:static}.stocklist{height:300px}.topline,.themein{padding-left:14px;padding-right:14px}.chart{height:430px}}
@media(max-width:620px){.brand small,.context small{display:none}.layout{padding:8px}.company{display:block}.mainquote{text-align:left;margin-top:16px}.databadge{margin-left:0}.kpis,.swot,.catalysts{grid-template-columns:1fr}.kpi{border-right:0;border-bottom:1px solid var(--line)}.kpi:last-child{border-bottom:0}.swotcell{border-right:0;border-bottom:1px solid var(--line)!important}.swotcell:last-child{border-bottom:0!important}.dhead,.section{padding:18px 16px}.shead{align-items:flex-start;flex-direction:column}.chart{height:390px}}
.overview{max-width:1580px;margin:0 auto;padding:22px 26px 38px}.overview.hidden,.layout.hidden{display:none}.overview-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:16px}.overview-head h1{font:700 30px/1.25 Georgia,"Noto Sans KR",serif;margin:0}.overview-head p{max-width:520px;margin:0;color:var(--muted);font-size:14px;line-height:1.6;text-align:right}.theme-grid{display:grid;grid-template-columns:repeat(4,1fr);min-height:560px;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden}.theme-panel{position:relative;border:0;border-right:1px solid var(--line);background:#fff;padding:30px 26px;text-align:left;display:flex;flex-direction:column;min-width:0}.theme-panel:last-child{border-right:0}.theme-panel:hover,.theme-panel:focus-visible{background:#f7f9f7;outline:none}.theme-panel:focus-visible{box-shadow:inset 0 0 0 3px var(--green)}.theme-panel:before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--theme-color)}.theme-panel small{font-size:12px;letter-spacing:.1em;color:var(--muted);font-weight:800}.theme-panel h2{font:700 25px/1.25 Georgia,"Noto Sans KR",serif;margin:13px 0 0}.theme-panel .background{margin-top:68px}.theme-panel .background b{font-size:14px}.theme-panel .background p{font-size:15px;line-height:1.75;color:#46534b;margin:12px 0 0}.theme-count{margin-top:auto;padding-top:30px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:13px}.theme-count strong{color:var(--ink);font-size:14px}.theme-arrow{font-size:20px;color:var(--green)}.allthemes{border:1px solid var(--line);background:#fff;color:#526058;border-radius:7px;padding:8px 12px;font-size:14px;font-weight:800;white-space:nowrap}.allthemes.active{background:var(--nav);border-color:var(--nav);color:#fff}
@media(max-width:1000px){.theme-grid{grid-template-columns:1fr 1fr;min-height:0}.theme-panel{min-height:360px;border-bottom:1px solid var(--line)}.theme-panel:nth-child(2n){border-right:0}.theme-panel:nth-child(n+3){border-bottom:0}.theme-panel .background{margin-top:35px}}
.markets{grid-template-columns:repeat(3,1fr)}
.top{display:none}.overview{max-width:none;min-height:100vh;margin:0;padding:0}.overview-head{display:none}.theme-grid{min-height:100vh;border:0;border-radius:0}.theme-panel{padding:clamp(28px,4vw,64px) clamp(24px,3vw,48px)}.theme-panel h2,.title h1,.overview-head h1{font-family:"Pretendard Variable",Pretendard,"Noto Sans KR",sans-serif;letter-spacing:-.035em}.theme-panel h2{font-size:clamp(27px,2.2vw,38px);font-weight:800}.theme-panel .background{margin-top:clamp(50px,12vh,130px)}.theme-panel .background b{font-size:15px}.theme-panel .background p{font-size:clamp(16px,1.25vw,19px);line-height:1.75}.sidebar{top:16px}.back-overview{width:100%;margin:0 0 13px;border:1px solid var(--line);background:#f7f9f7;color:var(--ink);border-radius:7px;padding:9px 11px;text-align:left;font-size:13px;font-weight:800}.back-overview:hover{background:var(--soft)}body{font-family:"Pretendard Variable",Pretendard,"Noto Sans KR",Arial,sans-serif;letter-spacing:-.012em}
.theme-panel .background{margin-top:clamp(32px,5vh,60px)}.logo-wall{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:clamp(22px,4vh,42px)}.theme-panel:last-child .logo-wall{grid-template-columns:repeat(2,minmax(0,1fr))}.logo-tile{height:56px;min-width:0;border:1px solid #e3e8e4;border-radius:10px;background:#fafbfa;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;transition:transform .16s ease,border-color .16s ease,background .16s ease}.theme-panel:hover .logo-tile{background:#fff}.logo-tile img,.logo-fallback{width:26px;height:26px;border-radius:7px;object-fit:contain}.logo-tile img{filter:saturate(.84)}.logo-fallback{display:grid;place-items:center;background:var(--soft);color:#3e4c43;font-size:10px;font-weight:900;letter-spacing:-.03em}.logo-tile em{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 4px;color:#6b766f;font-size:10px;font-style:normal;font-weight:800;text-align:center;letter-spacing:0}.theme-panel:hover .logo-tile{border-color:#d3dcd6}.theme-panel:hover .logo-tile:nth-child(3n+1){transform:translateY(-1px)}.theme-count{padding-top:20px}
@media(max-width:620px){.overview{padding:0;min-height:100vh}.overview-head{display:none}.theme-grid{grid-template-columns:1fr;min-height:100vh}.theme-panel{min-height:300px;border-right:0;border-bottom:1px solid var(--line)!important;padding:28px 22px}.theme-panel:last-child{border-bottom:0!important}.theme-panel .background{margin-top:30px}}
@media(max-width:1000px){.logo-wall{margin-top:26px}.logo-tile{height:56px}.theme-count{margin-top:24px}}
@media(max-width:620px){.logo-wall,.theme-panel:last-child .logo-wall{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.logo-tile{height:54px;border-radius:8px}.logo-tile img,.logo-fallback{width:25px;height:25px}.logo-tile em{font-size:9px}}
</style>
</head>
<body>
<header class="top"><div class="topline"><div class="brand"><span class="mark">S</span>Signal Book <small>THEME RESEARCH</small></div><div class="context"><b id="context">원전 및 에너지 · 해외</b><small>실제 스냅샷 / 미연결 데이터 구분</small></div></div><nav class="themes"><div class="themein" id="themes"></div></nav></header>
<section class="overview" id="overview"><div class="overview-head"><h1>관심 테마에서<br>주목할 종목 찾기</h1><p>테마 영역을 선택하면 관련 국내·해외 종목이 한 번에 펼쳐집니다. 이후 시장과 지표 기준으로 빠르게 좁혀보세요.</p></div><div class="theme-grid" id="themeGrid"></div></section>
<main class="layout hidden" id="workspace"><aside class="sidebar"><div class="sidehead"><button class="back-overview" id="backOverview">← 전체 테마</button><div class="path" id="path"></div><div class="markets" id="markets"></div><div class="tools"><input id="search" class="search" type="search" placeholder="종목명·티커 검색"><select id="sort" class="sort"><option value="change">등락률</option><option value="high52">52주 근접도</option><option value="rsi">RSI</option><option value="name">종목명</option></select></div><div class="summary" id="summary"></div></div><div class="stocklist" id="stocklist"></div></aside><article class="detail" id="detail"></article></main>
<script>
const THEMES=['AI','로봇','원전 및 에너지','바이오'],UPDATED='2026-09-09';
const THEME_INFO={AI:{eyebrow:'ARTIFICIAL INTELLIGENCE',text:'메모리, 소프트웨어, 데이터센터 전력처럼 AI 투자 사이클의 수요와 병목을 만드는 기업을 함께 봅니다.',color:'#2563eb'},'로봇':{eyebrow:'ROBOTICS',text:'수술·물류·협동·휴머노이드 로봇의 설치 기반, 상업화 속도와 반복 매출을 비교합니다.',color:'#7c3aed'},'원전 및 에너지':{eyebrow:'NUCLEAR & ENERGY',text:'우라늄 공급부터 원전 기자재, 발전 사업자와 데이터센터 전력 솔루션까지 가치사슬을 연결합니다.',color:'#b77905'},'바이오':{eyebrow:'BIOTECH',text:'항체 플랫폼, 세포치료, CDMO와 약물전달 기술의 임상·상업화 증거를 추적합니다.',color:'#be365d'}};
const THEME_LOGOS={
AI:[['NVDA','nvidia.com'],['AVGO','broadcom.com'],['AMD','amd.com'],['INTC','intel.com'],['TSMC','tsmc.com'],['ASML','asml.com'],['MU','micron.com'],['ARM','arm.com'],['ANET','arista.com'],['VRT','vertiv.com'],['PLTR','palantir.com'],['ORCL','oracle.com'],['SK hynix','skhynix.com'],['Samsung','samsung.com'],['CoreWeave','coreweave.com'],['Dell','dell.com']],
'로봇':[['Tesla','tesla.com'],['ISRG','intuitive.com'],['SYM','symbotic.com'],['ROK','rockwellautomation.com'],['CGNX','cognex.com'],['OUST','ouster.com'],['AEVA','aeva.com'],['HSAI','hesaitech.com'],['Rainbow','rainbow-robotics.com'],['Doosan','doosanrobotics.com'],['Neuromeka','neuromeka.com'],['SPG','spg.co.kr'],['Harmonic','hds.co.jp'],['Nabtesco','nabtesco.com'],['UBTECH','ubtrobot.com'],['Movex','hyundaimovex.com']],
'원전 및 에너지':[['CEG','constellationenergy.com'],['Cameco','cameco.com'],['Oklo','oklo.com'],['NuScale','nuscalepower.com'],['UEC','uraniumenergy.com'],['Denison','denisonmines.com'],['UUUU','energyfuels.com'],['BWXT','bwxt.com'],['GEV','gevernova.com'],['Bloom','bloomenergy.com'],['Vistra','vistracorp.com'],['NextEra','nexteraenergy.com'],['Doosan','doosanenerbility.com'],['LS ELC','ls-electric.com'],['Exxon','exxonmobil.com'],['Rio Tinto','riotinto.com']],
'바이오':[['IOVA','iovance.com'],['ABCL','abcellera.com'],['Samsung Bio','samsungbiologics.com'],['Alteogen','alteogen.com'],['AbbVie','abbvie.com'],['Novartis','novartis.com'],['ROKIT','rokithealthcare.com'],['JS Link','jslink.co.kr']]
};
function logoWall(theme){return'<div class="logo-wall" aria-hidden="true">'+THEME_LOGOS[theme].map(([label,domain])=>'<span class="logo-tile" title="'+esc(label)+'"><img src="https://www.google.com/s2/favicons?domain='+encodeURIComponent(domain)+'&sz=128" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span class="logo-fallback" hidden>'+esc(label).slice(0,3)+'</span><em>'+esc(label)+'</em></span>').join('')+'</div>'}
const STOCKS=[
['BB','BlackBerry','NYSE','USD','overseas',['AI'],'NYSE:BB','https://www.blackberry.com/us/en/company/investors'],
['ABCL','AbCellera Biologics','NASDAQ','USD','overseas',['AI','바이오'],'NASDAQ:ABCL','https://investors.abcellera.com/'],
['IOVA','Iovance Biotherapeutics','NASDAQ','USD','overseas',['바이오'],'NASDAQ:IOVA','https://ir.iovance.com/'],
['URA','Global X Uranium ETF','NYSE Arca','USD','overseas',['원전 및 에너지'],'AMEX:URA','https://www.globalxetfs.com/funds/ura'],
['DNNON','Denison Mines Ondo Token','Ondo','USD','overseas',['원전 및 에너지'],'AMEX:DNN','https://ondo.finance/',0,1],
['LPTH','LightPath Technologies','NASDAQ','USD','overseas',['로봇'],'NASDAQ:LPTH','https://ir.lightpath.com/'],
['DML','Denison Mines','TSX','CAD','overseas',['원전 및 에너지'],'TSX:DML','https://denisonmines.com/'],
['SMR','NuScale Power','NYSE','USD','overseas',['원전 및 에너지'],'NYSE:SMR','https://www.nuscalepower.com/'],
['UEC','Uranium Energy','NYSE American','USD','overseas',['원전 및 에너지'],'AMEX:UEC','https://www.uraniumenergy.com/'],
['CCO','Cameco','TSX','CAD','overseas',['원전 및 에너지'],'TSX:CCO','https://www.cameco.com/'],
['BWXT','BWX Technologies','NYSE','USD','overseas',['원전 및 에너지'],'NYSE:BWXT','https://investors.bwxt.com/'],
['CEG','Constellation Energy','NASDAQ','USD','overseas',['AI','원전 및 에너지'],'NASDAQ:CEG','https://investor.constellationenergy.com/'],
