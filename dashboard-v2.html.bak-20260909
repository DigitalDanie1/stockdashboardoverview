const LIST_SOURCES={
MATRIX:{name:'Investment Matrix',url:'https://matrix-ruddy-ten.vercel.app/'},
ROBOT:{name:'Robot Portfolio',url:'https://robot-portfolio-seven.vercel.app/'},
MULTI:{name:'Multiple Stock Price Tracker',url:'https://mutliplestockpricetracker.vercel.app/'},
COMMODITY:{name:'Commodity Tracker',url:'https://commoditytracker.vercel.app/'}
};
function addSourceGroup(theme,market,source,bucket,spec){let src=LIST_SOURCES[source];spec.split(';').filter(Boolean).forEach(row=>{let [id,name,exchange,currency,tv]=row.split('|'),found=STOCKS.find(s=>s.id===id);if(found){if(!found.themes.includes(theme))found.themes.push(theme);found.listSources=[...new Set([...(found.listSources||[]),src.name])];found.buckets=[...new Set([...(found.buckets||[]),bucket])];found.listUrl=found.listUrl||src.url;return}STOCKS.push({id,name:name||id,exchange:exchange||(market==='domestic'?'KRX':'US 상장'),currency:currency||(market==='domestic'?'KRW':'USD'),market,themes:[theme],tv:tv||null,ir:src.url,restricted:market==='domestic',proxy:false,listSources:[src.name],buckets:[bucket],listUrl:src.url})})}
