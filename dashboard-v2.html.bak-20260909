UUUU:['우라늄과 희토류 사업의 경제성 분리','미국 전략광물 자산|정책 수혜 경로','복잡한 사업믹스|자본집약','희토류 상업화|국산화 지원','상품 약세|지속 손실·희석','희토류 상업화','생산량·원가·계약','투자 지연','CAPEX·현금잔고'],
BE:['데이터센터 전력 수요의 수주·마진 전환','빠른 현장 발전|전력망 대기 회피','높은 밸류|고객 집중','대형 데이터센터 계약|서비스 성장','설치 지연|마진 미달','대형 수주','백로그·현금흐름','마진 전환 지연','매출총이익률'],
'034020':['원전·가스터빈 수주의 백로그·이익 전환','원전 주기기 역량|가스터빈 포트폴리오','프로젝트 변동|기대 선반영','글로벌 원전 계약|장기 백로그','계약 지연|원가 상승','글로벌 원전 수주','신규 계약·수주 마진','수익성 악화','영업현금흐름'],
'046120':['원전 방사선 관리·검사 수주의 실적 전환','원전 서비스 경험|정비 확대 노출','낮은 유동성|사업 변동','정비·해체 발주|작은 매출 레버리지','수주 공백|테마 되돌림','원전 서비스 수주','수주 공시·영업이익','테마 급등 되돌림','거래량·분기 이익'],
ISRG:['다빈치 설치 기반과 반복 기구·서비스 매출','대규모 생태계|높은 전환비용','높은 밸류|병원 CAPEX 민감','신규 시스템|적응증 확대','경쟁 로봇|가격 압박','시술량·설치 증가','시술 성장·설치 대수','경쟁 심화','점유율·장비 가격'],
SYM:['물류 자동화의 고객 확장과 설치 실행','AI 창고 플랫폼|대형 고객 관계','고객 집중|프로젝트 변동','신규 고객|서비스 비중 증가','설치 지연|원가 초과','신규 고객 확장','백로그·사이트 수','설치 지연','인도 일정·마진'],
'005930':['AI 메모리·파운드리 회복의 이익 믹스','사업 규모|대규모 투자 여력','파운드리 수율|메모리 사이클','HBM 확대|기술격차 축소','인증 지연|공급과잉','HBM 경쟁력 회복','출하·ASP·수율','기술 전환 지연','고객 인증·수율'],
'000660':['HBM 리더십과 AI 메모리 마진 지속성','HBM 경쟁력|AI 서버 직접 노출','메모리 사이클|고객 집중','차세대 HBM|제품 믹스 개선','경쟁 추격|공급과잉','차세대 HBM 출하','출하량·ASP·마진','메모리 가격 반전','가격·재고일수'],
'454910':['협동로봇 판매의 서비스·해외 확장','로봇 라인업|그룹 네트워크','수익성 미검증|밸류 부담','해외 채널|SW 매출 확대','가격 경쟁|산업 CAPEX 둔화','해외 수주 확대','수주·해외 매출·마진','적자 지속','영업손실·현금흐름'],
'277810':['휴머노이드 기술의 상업 매출 전환','고난도 이동 기술|전략 파트너','낮은 매출 가시성|기대 선반영','양산·공급계약|대기업 협력','개발 지연|테마 변동성','상업 공급계약','수주·양산 일정','상용화 지연','개발 일정·영업손실'],
'207940':['대규모 CMO 수주잔고의 가동률·마진 전환','세계적 생산능력|장기 계약','설비 가동률 민감|높은 CAPEX','아웃소싱 확대|신규 공장 램프','품질 이슈|경쟁 증설','신규 수주·가동률','백로그·마진','품질·가동 차질','규제 점검·가동률'],
'196170':['피하주사 플랫폼의 임상·허가 마일스톤','약물전달 기술|글로벌 파트너','일정 의존|수익 변동','추가 라이선스|플랫폼 범용성','허가 지연|특허 분쟁','파트너 허가 진척','임상·허가·마일스톤','개발·법적 지연','허가 일정·소송']
};
function profile(id){let x=P[id];if(!x)return{core:'외부 리스트에서 종목 기본정보만 가져왔습니다. 기업별 투자 논리와 근거 데이터는 아직 연결되지 않았습니다.',swot:[['기업별 사실 데이터 미연결','검증 후 분석 예정'],['기업별 사실 데이터 미연결','검증 후 분석 예정'],['기업별 사실 데이터 미연결','검증 후 분석 예정'],['기업별 사실 데이터 미연결','검증 후 분석 예정']],up:{name:'기업별 상승 촉매 데이터 미연결',check:'회사 IR·공시 연결 필요'},down:{name:'기업별 하락 촉매 데이터 미연결',check:'회사 IR·공시 연결 필요'}};let sw=x.slice(1,5).map(v=>v.split('|'));return{core:x[0],swot:sw,up:{name:x[5],check:x[6]},down:{name:x[7],check:x[8]}}}
const prefs=JSON.parse(localStorage.getItem('signal-theme-ui')||'{}'),app={mode:'overview',theme:prefs.theme||'원전 및 에너지',market:prefs.market||'all',selected:prefs.selected||'CEG',period:prefs.period||'6M',sort:prefs.sort||'change',search:'',scroll:0},periods=['1M','3M','6M','1Y','5Y'];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),stock=id=>STOCKS.find(x=>x.id===id),save=()=>localStorage.setItem('signal-theme-ui',JSON.stringify({theme:app.theme,market:app.market,selected:app.selected,period:app.period,sort:app.sort}));
function money(s,q){if(q.price==null)return '—';return new Intl.NumberFormat(s.currency==='KRW'?'ko-KR':'en-US',{style:'currency',currency:s.currency,maximumFractionDigits:s.currency==='KRW'?0:2}).format(q.price)}
function delta(v){return v==null?'—':(v>0?'▲ ':v<0?'▼ ':'')+Math.abs(v).toFixed(2)+'%'}function cls(v){return v==null?'neutral':v>0?'up':v<0?'down':'neutral'}function prox(q){return q.price!=null&&q.high52!=null?(q.price/q.high52-1)*100:null}
const marketLabel=m=>m==='domestic'?'국내':m==='overseas'?'해외':'전체';
function rows(){let r=STOCKS.filter(s=>s.themes.includes(app.theme)&&(app.market==='all'||s.market===app.market));if(app.search){let k=app.search.toLowerCase();r=r.filter(s=>(s.name+' '+s.id).toLowerCase().includes(k))}r.sort((a,b)=>{let qa=Q[a.id],qb=Q[b.id],va=app.sort==='change'?qa.change:app.sort==='high52'?prox(qa):app.sort==='rsi'?qa.rsi:null,vb=app.sort==='change'?qb.change:app.sort==='high52'?prox(qb):app.sort==='rsi'?qb.rsi:null;if(app.sort==='name'||(va==null&&vb==null))return a.name.localeCompare(b.name,'ko');if(va==null)return 1;if(vb==null)return-1;return vb-va});return r}
function renderOverview(){document.querySelector('#themeGrid').innerHTML=THEMES.map(t=>{let info=THEME_INFO[t],dom=STOCKS.filter(s=>s.themes.includes(t)&&s.market==='domestic').length,over=STOCKS.filter(s=>s.themes.includes(t)&&s.market==='overseas').length;return'<button class="theme-panel" style="--theme-color:'+info.color+'" data-open-theme="'+t+'"><small>'+info.eyebrow+'</small><h2>'+t+'</h2><div class="background"><b>관련 배경</b><p>'+info.text+'</p></div>'+logoWall(t)+'<div class="theme-count"><span><strong>국내 '+dom+'</strong> · 해외 '+over+'</span><span class="theme-arrow">→</span></div></button>'}).join('');document.querySelectorAll('[data-open-theme]').forEach(b=>b.onclick=()=>{app.mode='explore';app.theme=b.dataset.openTheme;app.market='all';app.search='';app.scroll=0;document.querySelector('#search').value='';render()})}
function renderChrome(){document.querySelector('#themes').innerHTML='<button class="allthemes '+(app.mode==='overview'?'active':'')+'" id="allthemes">전체 테마</button><span>테마</span>'+THEMES.map(t=>'<button class="theme '+(app.mode==='explore'&&t===app.theme?'active':'')+'" data-theme="'+t+'">'+t+'</button>').join('');document.querySelector('#markets').innerHTML=['all','domestic','overseas'].map(m=>'<button class="market '+(m===app.market?'active':'')+'" data-market="'+m+'">'+marketLabel(m)+'</button>').join('');document.querySelector('#context').textContent=app.mode==='overview'?'테마 인텔리전스':app.theme+' · '+marketLabel(app.market);document.querySelector('#path').innerHTML='<b>'+app.theme+'</b> / '+marketLabel(app.market)+' / '+(app.selected?stock(app.selected).name:'선택 없음');document.querySelector('#sort').value=app.sort;document.querySelector('#allthemes').onclick=()=>{app.mode='overview';render()};document.querySelectorAll('[data-theme]').forEach(b=>b.onclick=()=>{app.mode='explore';app.theme=b.dataset.theme;app.market='all';app.scroll=0;render()});document.querySelectorAll('[data-market]').forEach(b=>b.onclick=()=>{app.market=b.dataset.market;app.scroll=0;render()})}
function renderList(r){let el=document.querySelector('#stocklist'),known=r.filter(s=>Q[s.id].change!=null),up=known.filter(s=>Q[s.id].change>0).length,avg=known.length?known.reduce((n,s)=>n+Q[s.id].change,0)/known.length:null;document.querySelector('#summary').innerHTML='<span>'+r.length+'종목 · 시세 '+known.length+'</span><span>상승 '+up+(avg==null?'':' · 평균 '+(avg>=0?'+':'')+avg.toFixed(2)+'%')+'</span>';if(!r.length){el.innerHTML='<div class="empty">조건에 맞는 종목이 없습니다.<br>검색어를 지우거나 시장을 변경하세요.</div>';return}el.innerHTML=r.map(s=>{let q=Q[s.id];return'<button class="stock '+(s.id===app.selected?'active':'')+'" data-id="'+s.id+'"><span class="sname"><b>'+s.name+'</b><span><i class="dot '+(q.mode==='snapshot'?'real':'')+'"></i>'+s.id+' · '+s.exchange+'</span></span><span class="squote"><b>'+money(s,q)+'</b><small class="'+cls(q.change)+'">'+delta(q.change)+'</small></span></button>'}).join('');el.scrollTop=app.scroll;el.onscroll=()=>app.scroll=el.scrollTop;el.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>{app.scroll=el.scrollTop;app.selected=b.dataset.id;save();renderChrome();renderList(rows());renderDetail()})}
function kpi52(s,q){let p=prox(q);if(p==null)return'<div class="klabel">① 52주 신고가 근접도</div><div class="kvalue">— <span class="chip gray">데이터 미연결</span></div><div class="ksub">52주 최고가와 수정주가 기준이 필요합니다.</div>';let status=p>=0?'신고가':p>=-5?'신고가 근접':'최고가 대비',width=Math.max(0,Math.min(100,100+p));return'<div class="klabel">① 52주 신고가 근접도</div><div class="kvalue">'+p.toFixed(1)+'% <span class="chip '+(p>=-5?'green':'gray')+'">'+status+'</span></div><div class="ksub">현재 '+money(s,q)+' · 최고 '+money(s,{price:q.high52})+'</div><div class="track"><div class="fill" style="width:'+width+'%"></div></div><div class="ksub">'+(q.adjusted===false?'수정주가 미적용':'수정주가 적용 여부 미확인')+'</div>'}
function kpiRSI(q){let label=q.rsi==null?'데이터 미연결':q.rsi>=70?'과매수 구간':q.rsi<=30?'과매도 구간':'중립 구간',c=q.rsi==null?'gray':q.rsi>=70?'red':q.rsi<=30?'amber':'green';return'<div class="klabel">② RSI(14) · 일봉 Wilder</div><div class="kvalue">'+(q.rsi==null?'—':q.rsi.toFixed(1))+' <span class="chip '+c+'">'+label+'</span></div><div class="ksub">70 이상 과매수 · 30 이하 과매도. 매매 추천이 아닙니다.</div>'}
function kpiDir(q){let label='판단 불가',c='gray',why='일봉 종가·20일·60일 이동평균 데이터가 필요합니다.';if([q.price,q.ma20,q.ma60].every(v=>v!=null)){if(q.price>q.ma20&&q.ma20>q.ma60){label='강세';c='green';why='종가 > 20일선 > 60일선'}else if(q.price<q.ma20&&q.ma20<q.ma60){label='약세';c='red';why='종가 < 20일선 < 60일선'}else{label='중립';c='amber';why='정배열·역배열 조건 외'}}return'<div class="klabel">③ 차트 방향성 · 일봉</div><div class="kvalue">'+label+' <span class="chip '+c+'">20D / 60D</span></div><div class="ksub">'+why+'<br>표시 기간과 무관하게 일봉 기준입니다.</div>'}
function cat(side,title,c,s){return'<div class="catcol"><div class="cattitle '+side+'">'+title+'</div><div class="catbody"><h3>'+c.name+'</h3><p>'+(side==='pos'?'이 조건의 확인은 이익 기대와 밸류에이션을 높일 수 있습니다.':'이 조건은 투자 논리와 기대 수익을 약화시킬 수 있습니다.')+'</p><div class="catmeta"><b>예정/관찰</b><span>'+(side==='pos'?'일정 미정':'상시 관찰')+'</span><b>확인 조건</b><span>'+c.check+'</span><b>상태</b><span>진행 중 · 시나리오</span><b>출처</b><span><a href="'+s.ir+'" target="_blank" rel="noopener">회사 IR/공시 ↗</a></span><b>업데이트</b><span>'+UPDATED+'</span></div></div></div>'}
function renderDetail(){let root=document.querySelector('#detail');if(!app.selected){root.innerHTML='<div class="empty">종목을 선택하세요.</div>';return}let s=stock(app.selected),q=Q[s.id],p=profile(s.id),names=['강점','약점','기회','위협'];root.innerHTML='<header class="dhead"><div class="crumb">'+app.theme+' / '+(app.market==='domestic'?'국내':'해외')+' / <b>'+s.name+'</b></div><div class="company"><div class="title"><h1>'+s.name+'</h1><div class="tags"><span class="tag">'+s.id+'</span><span class="tag">'+s.exchange+'</span><span class="tag">'+s.currency+'</span>'+s.themes.map(t=>'<span class="tag">'+t+'</span>').join('')+'</div></div><div class="mainquote"><strong>'+money(s,q)+'</strong><span class="'+cls(q.change)+'">'+delta(q.change)+'</span><small>'+(q.asof||'시세 기준 시각 미연결')+'</small><span class="databadge '+(q.mode==='missing'?'warn':'')+'">'+(q.mode==='snapshot'?'실제 지연 스냅샷':'시세 미연결')+(q.cap?' · '+q.cap:'')+'</span></div></div></header><section class="kpis"><div class="kpi">'+kpi52(s,q)+'</div><div class="kpi">'+kpiRSI(q)+'</div><div class="kpi">'+kpiDir(q)+'</div></section><section class="section"><div class="shead"><div><h2>가격 차트</h2><p>'+(s.restricted?'KRX 데이터는 TradingView 원본에서 확인':'캔들·거래량·시간봉·이동평균은 TradingView 도구막대에서 선택')+(s.proxy?' · DNN 기초자산 프록시':'')+'</p></div><div class="periods">'+periods.map(x=>'<button class="period '+(x===app.period?'active':'')+'" data-period="'+x+'">'+x+'</button>').join('')+'</div></div><div class="chart" id="chart"></div></section><section class="section"><div class="shead"><div><h2>SWOT 분석</h2><p>확인된 사실과 분석 해석 분리 · '+UPDATED+'</p></div></div><div class="thesis">'+p.core+'</div><div class="swot">'+p.swot.map((x,i)=>'<div class="swotcell"><h3>'+names[i]+'</h3><ul><li><span class="kind">사실</span>'+x[0]+'</li><li><span class="kind">해석</span>'+x[1]+'</li></ul><details><summary>근거와 출처 보기</summary><div class="source">회사 공시·IR 우선 확인. 이 문장은 리서치 분석 요약입니다.<br><a href="'+s.ir+'" target="_blank" rel="noopener">회사 자료 열기 ↗</a> · '+UPDATED+'</div></details></div>').join('')+'</div></section><section class="section"><div class="shead"><div><h2>상승·하락 촉매제</h2><p>발표 사실과 향후 시나리오를 구분</p></div></div><div class="catalysts">'+cat('pos','상승 촉매제',p.up,s)+cat('neg','하락 촉매제',p.down,s)+'</div></section><footer class="foot">가격은 지연 스냅샷이며 실시간 거래 데이터가 아닙니다. 기술지표는 검증된 일봉 데이터가 연결된 경우에만 계산합니다. 일정 미정은 발표된 날짜가 없다는 뜻이며, 시나리오는 확정 사실이 아닙니다.</footer>';root.querySelectorAll('[data-period]').forEach(b=>b.onclick=()=>{app.period=b.dataset.period;save();renderDetail()});loadChart(s)}
function loadChart(s){let root=document.querySelector('#chart');if(!s.tv){let url=s.listUrl||s.ir;root.innerHTML='<div class="fallback"><div><h3>'+s.name+' · '+s.id+'</h3><p>원본 목록에서 정확한 거래소 코드가 확인되지 않아 임의의 TradingView 심볼을 연결하지 않았습니다. 거래소 매핑 검증 후 차트가 활성화됩니다.</p><a class="tvlink" href="'+url+'" target="_blank" rel="noopener">목록 출처에서 확인하기 ↗</a></div></div>';return}if(s.restricted){root.innerHTML='<div class="fallback"><div><h3>'+s.name+' · '+s.id+'</h3><p>한국거래소 시세는 TradingView 데이터 라이선스 정책상 외부 임베드에서 제공되지 않습니다. 모의 차트를 표시하지 않고 원본 차트로 연결합니다.</p><a class="tvlink" href="https://www.tradingview.com/chart/?symbol='+encodeURIComponent(s.tv)+'" target="_blank" rel="noopener">TradingView에서 차트 열기 ↗</a></div></div>';return}root.innerHTML='<div class="tradingview-widget-container"><div class="tradingview-widget-container__widget"></div><div class="tradingview-widget-copyright"><a href="https://www.tradingview.com/symbols/'+s.tv.replace(':','-')+'/" target="_blank" rel="noopener nofollow">'+s.id+' chart</a> by TradingView</div></div>';let script=document.createElement('script');script.src='https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';script.async=true;script.text=JSON.stringify({autosize:true,symbol:s.tv,interval:'D',range:app.period,timezone:'Asia/Singapore',theme:'light',style:'1',locale:'kr',allow_symbol_change:false,hide_side_toolbar:false,hide_volume:false,withdateranges:true,details:true,calendar:false,support_host:'https://www.tradingview.com'});root.querySelector('.tradingview-widget-container').appendChild(script)}
function render(){renderOverview();renderChrome();let overview=document.querySelector('#overview'),workspace=document.querySelector('#workspace');if(app.mode==='overview'){overview.classList.remove('hidden');workspace.classList.add('hidden');return}overview.classList.add('hidden');workspace.classList.remove('hidden');let old=document.querySelector('#stocklist');if(old)app.scroll=old.scrollTop;let r=rows();if(!r.some(s=>s.id===app.selected))app.selected=r[0]?.id||null;save();renderChrome();renderList(r);renderDetail()}
document.querySelector('#search').oninput=e=>{app.search=e.target.value;app.scroll=0;render()};document.querySelector('#sort').onchange=e=>{app.sort=e.target.value;app.scroll=0;render()};document.querySelector('#backOverview').onclick=()=>{app.mode='overview';render()};
async function refreshDNNON(){try{let r=await fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=denison-mines-ondo-tokenized-stocks&price_change_percentage=24h'),d=(await r.json())[0];if(d?.current_price){Q.DNNON.price=d.current_price;Q.DNNON.change=d.price_change_percentage_24h_in_currency||d.price_change_percentage_24h||0;Q.DNNON.asof=new Date(d.last_updated).toLocaleString('ko-KR');render()}}catch(e){}}
const baseRenderDetail=renderDetail;renderDetail=function(){baseRenderDetail();if(app.selected){let s=stock(app.selected),c=document.querySelector('.crumb');if(c)c.innerHTML=app.theme+' / '+marketLabel(app.market)+' / <b>'+s.name+'</b>';if(s.buckets?.length){let tags=document.querySelector('.tags');tags.insertAdjacentHTML('beforeend',s.buckets.map(x=>'<span class="tag">'+esc(x)+'</span>').join(''))}if(s.listSources?.length){let tags=document.querySelector('.tags');tags.insertAdjacentHTML('beforeend','<span class="tag">출처 · '+esc(s.listSources.join(' + '))+'</span>');document.querySelectorAll('.source a,.catmeta a').forEach(a=>{a.textContent='목록 출처 열기 ↗';a.href=s.listUrl||s.ir})}}};
render();refreshDNNON();
</script>
</body>
</html>
